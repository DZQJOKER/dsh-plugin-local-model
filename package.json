{
  "name": "dsh-plugin-local-model",
  "version": "0.5.2",
  "description": "DeepSeek Harness 本地模型插件：设置里独立的「本地模型」页，首条对话自动拉起 llama.cpp，空闲 5 分钟自动卸载释放资源。",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DZQJOKER/dsh-plugin-local-model.git"
  },
  "homepage": "https://github.com/DZQJOKER/dsh-plugin-local-model#readme",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "^0.1.0-rc.1 || ^0.1.1-0 || ^0.1.2-0 || ^0.1.5-0"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:client",
    "build:client": "node scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "node scripts/verify-bundle.mjs",
    "verify:llama": "node scripts/verify-llama.mjs",
    "pretest": "npm run build",
    "test": "node scripts/verify-bundle.mjs && node scripts/client-check.mjs && node scripts/load-check.mjs && node scripts/selftest.mjs && node scripts/e2e.mjs",
    "test:load": "node scripts/load-check.mjs",
    "test:client": "node scripts/client-check.mjs",
    "test:unit": "node scripts/selftest.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "fetch:llama": "node scripts/fetch-llama.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.1 || ^0.1.1-0 || ^0.1.2-0 || ^0.1.5-0",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-tools": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3"
  }
}
